rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every document lives under /users/{uid}/... — only the signed-in owner
    // of that uid can read or write anything beneath it. Unauthenticated
    // requests, and requests for someone else's uid, are rejected outright.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
